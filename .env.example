# =============================================================================
# Flux Protocol — environment template
# Copy: cp .env.example .env && fill PRIVATE_KEY (never commit .env)
# =============================================================================

PRIVATE_KEY=

# Default RPC for generic scripts (Anvil local)
RPC_URL=http://127.0.0.1:8545

# Per-chain RPC (foundry.toml [rpc_endpoints]: monad | bsc | hyperliquid | local)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
HYPERLIQUID_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
# Optional mainnet (see docs/deploy-bsc.md)
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# Default target for script/flux-forge.sh when --network is omitted
FLUX_NETWORK=monad
DEPLOY_CHAIN=monad

# Protocol roles (use Safe/Timelock on mainnet)
PROTOCOL_ADMIN=
PROTOCOL_TREASURY=
LP_LOCK=0x000000000000000000000000000000000000dEaD

# Optional integrations — leave empty for hackathon / demo (Mock VRF + Mock LP)
# BSC PancakeSwap V2 Router (Uniswap V2–compatible interface):
#   Mainnet: 0x10ED43C718714eb63d5aB57B68Dd30B70f9A79cb
#   Testnet: 0xD99D1c33F9fC3444fbf97E0b095693cFf0eaf586
UNISWAP_V2_ROUTER=
# LBP / liquidity-launcher wrapper implementing migrateGenesisPool — NOT PoolManager.
# Uniswap v4 core (reference only — do NOT paste into UNISWAP_V4_MIGRATOR):
#   BSC 56 PoolManager:     0x28e2ea090877bf75740558f6bfb36a5ffee9e9df
#   Monad 143 PoolManager:  0x188d586ddcf52439676ca21a244753fa19f9ea8e
#   Monad testnet 10143 / BSC testnet 97: no official v4 in Uniswap deployment list
# See docs/uniswap-v4-chain-reference.md
UNISWAP_V4_MIGRATOR=
# Set true to use legacy no-swap MockUniswapV4Migrator instead of Flux V2-style AMM
FLUX_LEGACY_V4_MOCK=

# Flux hackathon AMM (filled by Deploy.s.sol → deployments/<chainId>.json)
FLUX_SWAP_ROUTER=
# Protocol fee on FluxSwapRouter swaps (bps); sent to FeeEngine — default 30 in Deploy.s.sol
FLUX_SWAP_PROTOCOL_FEE_BPS=30
SWAP_ETH_IN=0.01ether
SWAP_TOKEN_IN=
MIN_TOKEN_OUT=0
MIN_ETH_OUT=0

VRF_COORDINATOR=

# Contract verification (BSC only; Monad use explorer UI / monadvision)
ETHERSCAN_API_KEY=

# Post-deploy addresses (filled after Deploy.s.sol → deployments/<chainId>.json)
GENESIS_AUCTION=
CONVERSION_ENGINE=
GENESIS_VAULT=
FEE_ENGINE=
FluxToken=
DynamicNFT=
FluxAMMFactory=
LiquidityMigrator=

# Auction actions (script/AuctionActions.s.sol, StartAuction.s.sol)
# StartAuction defaults: start = now + 2min, duration = 1h (override with AUCTION_END absolute timestamp)
AUCTION_START=
AUCTION_END=
AUCTION_DURATION=3600
MAX_PRICE=
BID_BUDGET=
CLEARING_PRICE=

# Protocol actions (script/ProtocolActions.s.sol)
ASSET_ID=
TOKEN_ID=
TRAIT_SEED=
